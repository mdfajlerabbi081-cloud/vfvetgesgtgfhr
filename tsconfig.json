{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "next": ["./src/compat/next.ts"],
      "next/navigation": ["./src/compat/next-navigation.ts"],
      "next/headers": ["./src/compat/next-headers.ts"],
      "next/server": ["./src/compat/next-server.ts"],
      "next/font/google": ["./src/compat/next-font.ts"],
      "next/link": ["./src/compat/Link.tsx"],
      "next/image": ["./src/compat/Image.tsx"],
      "@/src/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": ["dist", "next.config.js"]
}
